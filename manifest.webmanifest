  "lang": "vi",
  "dir": "ltr",
  "start_url": "./?src=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#101A15",
  "theme_color": "#0B2F20",
  "categories": ["education", "health", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nộp chạy bộ", "short_name": "Chạy bộ", "url": "./?go=run", "icons": [{ "src": "icon-maskable-192.png", "sizes": "192x192" }] },
    { "name": "Đọc 7 điều cam kết", "short_name": "Cam kết", "url": "./?go=mind", "icons": [{ "src": "icon-maskable-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
